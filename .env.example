# Server configuration
PORT=5000
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_db?schema=public
APP_URL=http://localhost:5000
JWT_SECRET=your_jwt_secret_key
DOCKER_USERNAME=your_docker_username

# Stripe secret key for payment processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Seeded super admin credentials
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=your_strong_password

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Duffel configuration
DUFFEL_API_KEY=duffel_test_your_duffel_api_key

# OpenWeatherMap configuration
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Firebase configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Environment
NODE_ENV=development