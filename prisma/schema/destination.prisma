model Destination {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @db.Text
  location      String
  isPopular     Boolean  @default(false)
  perPersonCost Float
  image         String
  savedByUsers  UserSavedDestination[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
